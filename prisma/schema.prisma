//   // user User

//   publicKey Bytes
//   encryptedUserPrivateKey
// }

model User {
  id          String @id @default(uuid())
  userName    String @unique
  selfGroup   Group  @relation(fields: [selfGroupId], references: [id], name: "SelfUserGroup")
  selfGroupId String @unique
  // admin       Boolean @default(false) // Admins are allowed to create new object types


  // authKey: Deviced from the master user password. authKey = pwhash(password, authSalt)
  authSalt Bytes
  authHashedKey Bytes // Used to verify user. authHashedKey = crypto_generichash(authKey)

  // encryptionKey: Derived from the master user password. encryptionKey = pwhash(password, encryptionSalt)
  encryptionSalt Bytes

  publicKey Bytes
  encryptedPrivateKey Bytes // Encrypted with encryptionKey, which is derived from the master user password
  encryptedPrivateKeyNonce Bytes

  groups GroupUserPermission[]

  @@unique([id, selfGroupId])
}

model GroupUserPermission {
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  groupId String
  group   Group  @relation(fields: [groupId], references: [id])

  encryptedGroupPrivateKey Bytes // Encrypted using User public key

  @@id([userId, groupId])
}

model Group {
  id String @id @default(uuid())

  selfUser User? @relation(name: "SelfUserGroup")

  publicKey Bytes
  // privateKey: stored in GroupUserPermission

  users   GroupUserPermission[]
  objects ObjectGroupPermission[]
}

model ObjectGroupPermission {
  groupId    String
  group      Group   @relation(fields: [groupId], references: [id])
  objectId   BigInt
  object     Object  @relation(fields: [objectId], references: [id])
  allowRead  Boolean @default(true)
  allowWrite Boolean @default(true)

  encryptedObjectKey Bytes // Encrypted using Group public key

  @@id([groupId, objectId])
}

model Object {
  id         BigInt @id @default(autoincrement())
  type       String // User specified type of the object, eg "ShoppingItem", "UserProfile"
  data       Bytes
  nonce      Bytes
  publicData Json?

  groups ObjectGroupPermission[]
  // objectType ObjectType              @relation(fields: [type], references: [type])

  // @@index([publicData]) // Will only work for operations on the whole json
  @@index([type])
}

